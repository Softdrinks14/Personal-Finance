# ==========================================================
# Contoh file environment. Salin jadi `.env.local` lalu isi.
#   cp .env.local.example .env.local
#
# Kalau dua baris di bawah DIBIARKAN KOSONG, aplikasi otomatis
# jalan dalam MODE LOCAL (data disimpan di localStorage browser).
# Jadi kamu tetap bisa mencoba aplikasi tanpa Supabase.
# ==========================================================

# Ambil dari Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
